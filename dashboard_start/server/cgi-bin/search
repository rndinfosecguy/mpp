all_content = ""
if query != "":
  conn = sqlite3.connect('../data.db')
  c = conn.cursor()
  search = "%" + query + "%"
  c.execute("SELECT ip, query FROM dns_queries WHERE query like ?", (search,))
  row = c.fetchall()
  for line in row:
    c.execute("SELECT ip, date FROM targets where id=?", (line[0],))
    target = c.fetchone()
    tmp = content.replace("<TIME>", datetime.fromtimestamp(int(float(target[1]))).strftime('%Y-%m-%d %H:%M:%S'))
    tmp = tmp.replace("<IP>", target[0])
    tmp = tmp.replace("<QUERY>", line[1])
    all_content += tmp

print(head)
