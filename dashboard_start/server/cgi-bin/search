  pointer-events:none;z-index:0;
}}
body::after{{
  content:'';position:fixed;bottom:-200px;right:-100px;
  width:500px;height:500px;
  background:radial-gradient(circle,rgba(16,185,129,0.08),transparent 70%);
  pointer-events:none;z-index:0;
