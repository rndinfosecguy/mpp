#!/usr/bin/env python3
import sqlite3
from urllib.parse import parse_qs
import os
from datetime import datetime
import html as html_mod

query_string = os.environ.get("QUERY_STRING", "")
params = parse_qs(query_string)
search_query = params.get("query", [""])[0]

print("Content-Type: text/html")
print()

conn = sqlite3.connect("../data.db")
c = conn.cursor()

results = []
if search_query:
    pattern = "%" + search_query + "%"
    c.execute("SELECT ip, query FROM dns_queries WHERE query LIKE ?", (pattern,))
    for ip_id, domain in c.fetchall():
        c.execute("SELECT ip, date FROM targets WHERE id=?", (ip_id,))
        target = c.fetchone()
        if target:
            ts = datetime.fromtimestamp(int(float(target[1]))).strftime("%Y-%m-%d %H:%M:%S")
            results.append((ts, target[0], domain))

conn.close()

result_rows = ""
for ts, ip, domain in results:
    safe_domain = html_mod.escape(domain)
    safe_ip = html_mod.escape(ip)
    result_rows += f"""<tr>
  <td class="ts-cell">{ts}</td>
  <td class="ip-cell">{safe_ip}</td>
  <td class="domain-cell">{safe_domain}</td>
</tr>\n"""

result_count = len(results)
if search_query:
    count_html = f'<span class="count-badge">{result_count} result{"s" if result_count != 1 else ""} for &ldquo;{html_mod.escape(search_query)}&rdquo;</span>'
else:
    count_html = '<span class="count-hint">Type a domain or keyword to search DNS queries</span>'

html = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DNS Query Search &mdash; MPP</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*{{margin:0;padding:0;box-sizing:border-box}}
body{{
  font-family:'Inter',sans-serif;
  background:#0b0e1a;color:#f8fafc;
  min-height:100vh;overflow-x:hidden;
}}
body::before{{
  content:'';position:fixed;top:-250px;left:50%;transform:translateX(-50%);
  width:800px;height:800px;
