</style>
</head>
<body>
<div class="page">
  <nav>
    <div class="nav-brand">🍍 MPP</div>
    <div class="nav-links">
      <a href="/cgi-bin/dashboard">Dashboard</a>
      <a href="/cgi-bin/search" class="active">DNS Queries</a>
    </div>
  </nav>

  <a href="/cgi-bin/dashboard" class="back">&larr; Back to Dashboard</a>

  <div class="page-title">DNS Query Search</div>
  <div class="page-sub">Search through all captured DNS queries across devices</div>

  <div class="search-box">
    <input type="text" id="searchInput" placeholder="e.g. google.com, instagram, whatsapp..." value="{html_mod.escape(search_query)}" onkeyup="handleKey(event)" />
  </div>

  {count_html}

  <div class="results">
"""

if result_rows:
    html += f"""    <table>
      <thead>
        <tr>
          <th>Timestamp</th>
          <th>IP Address</th>
          <th>Domain</th>
        </tr>
      </thead>
      <tbody>
{result_rows}      </tbody>
    </table>
"""
else:
    if search_query:
        html += '    <div class="empty"><div class="empty-icon">&#128270;</div>No DNS queries match &ldquo;' + html_mod.escape(search_query) + '&rdquo;</div>\n'
    else:
        html += '    <div class="empty"><div class="empty-icon">&#128269;</div>Enter a search term above to find DNS queries</div>\n'

html += """  </div>
</div>
<script>
function handleKey(e){if(e.key==='Enter'){submitSearch()}}
function submitSearch(){
  var v=document.getElementById('searchInput').value;
  var p=new URLSearchParams({query:v});
  window.location.href=window.location.pathname+'?'+p.toString();
}
</script>
</body>
</html>"""

print(html)
