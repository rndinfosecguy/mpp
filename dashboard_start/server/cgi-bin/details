dns_entry = """
        <tr>
          <td><QUERY></td>
        </tr>
"""



print(head)

# device information
conn = sqlite3.connect('../data.db')
c = conn.cursor()
c.execute("SELECT mac, pcap, date, id FROM targets WHERE ip=?", (ip,))
row = c.fetchone()
ip_id = row[3]

tmp = mac_credentials_os.replace("<MAC>", row[0])
tmp = tmp.replace("<PCAP>", row[1].split("/")[len(row[1].split("/"))-1])
readable_date = datetime.fromtimestamp(int(float(row[2]))).strftime('%Y-%m-%d %H:%M:%S')
tmp = tmp.replace("<DATE>", readable_date)

c.execute("SELECT count(id) FROM credentials WHERE target=?", (ip_id,))
row = c.fetchone()
if int(row[0]) == 1:
  c.execute("SELECT username, password, hostname FROM credentials WHERE target=?", (ip_id,))
  row = c.fetchone()
  tmp = tmp.replace("<CREDS>", "user:" + row[0] + " pass:" + row[1])
  tmp = tmp.replace("<HOSTNAME>", row[2])
else:
  tmp = tmp.replace("<CREDS>", "n/a")
  tmp = tmp.replace("<HOSTNAME>", "n/a")

device_info = tmp

# apps
c.execute("SELECT appname FROM targetapps WHERE target=?", (ip_id,))
rows = c.fetchall()
all_apps = ""

different_apps = set()
for c_app in rows:
  tmp = app.replace("<APP>", "DEVICE/APP")
  c.execute("SELECT app from apps WHERE id=?", (c_app[0],))
  row = c.fetchone()
  if row[0] not in different_apps:
    all_apps += tmp.replace("<APPNAME>", row[0])
    different_apps.add(row[0])

os_type = "n/a"
for item in different_apps:
  if item == "Android" or item == "iPhone":
    os_type = item

print(device_info.replace("<OS>", os_type))
print(apps.replace("<APPS>", all_apps))

# dns queries
c.execute("SELECT distinct query FROM dns_queries WHERE ip=?", (ip_id,))
rows = c.fetchall()

all_entries = ""
for query in rows:
  all_entries += dns_entry.replace("<QUERY>", query[0])
print(dns.replace("<DNS_QUERIES>", all_entries))

conn.close()
