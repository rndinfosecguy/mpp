</style>
</head>
<body>
<div class="page">
  <nav>
    <div class="nav-brand">🍍 MPP</div>
    <div class="nav-links">
      <a href="/cgi-bin/dashboard" class="active">Dashboard</a>
      <a href="/cgi-bin/search">DNS Queries</a>
    </div>
  </nav>

  <div class="summary">
    <div class="stat" style="--accent:#3b82f6">
      <div class="stat-label">Devices</div>
      <div class="stat-value blue" id="statDevices">{n}</div>
    </div>
    <div class="stat" style="--accent:#10b981">
      <div class="stat-label">Credentials</div>
      <div class="stat-value green" id="statCreds">{total_creds}</div>
    </div>
    <div class="stat" style="--accent:#8b5cf6">
      <div class="stat-label">Apps Detected</div>
      <div class="stat-value purple" id="statApps">{total_apps}</div>
    </div>
    <div class="stat" style="--accent:#f59e0b">
      <div class="stat-label">DNS Queries</div>
      <div class="stat-value amber" id="statDns">{total_dns}</div>
    </div>
  </div>

  <div class="search-wrap">
    <input type="text" id="searchInput" placeholder="Search devices, IPs, apps..." onkeyup="filterDevices()" />
  </div>

  <div class="devices" id="deviceList">
"""

if n == 0:
    html += '    <div class="empty"><div class="empty-icon">&#128270;</div>No devices found. Run <code>setup.py</code> to populate the database.</div>\n'
else:
    for d in target_data:
        color = "#3b82f6"
        cred_html = '<span class="cred-badge no">No creds</span>'
        if d["has_creds"] and d["username"] and d["username"] != "NONE":
            cred_html = f'<span class="cred-badge yes">&#10003; {d["username"]}</span>'
            color = "#10b981"

        os_html = ""
        if d["os"]:
            os_color = app_colors.get(d["os"], "#6366f1") if d["os"] != "Mixed" else "#f59e0b"
            os_html = f'<span class="cred-badge" style="background:{os_color}22;color:{os_color}">{d["os"]}</span>'

        app_tags = ""
        for app in d["apps"]:
            if app in ("iOS", "Android"):
                continue
            bg = app_colors.get(app, "#6366f1")
            app_tags += f'<span class="app-tag" style="background:{bg}">{app}</span>'

        searchable_apps = " ".join(a for a in d["apps"] if a not in ("iOS", "Android"))
        searchable = f'{d["ip"]} {d["mac"]} {d["hostname"]} {d.get("username","")} {searchable_apps} {d["os"] or ""}'.lower()

        html += f"""    <div class="device-card" style="--accent:{color}" data-search="{searchable}" data-dns="{d["dns_count"]}">
      <div class="device-top">
        <div>
          <a href="details?ip={d['ip']}" class="device-ip">{d['ip']}</a>
          <div class="device-meta">
            <span>{d['mac']}</span>
            <span>{d['hostname']}</span>
          </div>
        </div>
        <div style="display:flex;gap:8px;align-items:center">{os_html}{cred_html}</div>
      </div>
      <div class="device-bottom">
        <div class="app-tags">{app_tags}</div>
        <div class="device-meta">{d['date']} &middot; {d['pcap']}</div>
      </div>
    </div>
"""

html += """  </div>
</div>
<script>
function filterDevices(){
  var v=document.getElementById('searchInput').value.toLowerCase();
  var cards=document.querySelectorAll('.device-card');
  var visCount=0,credCount=0,appSet={},dnsTotal=0;
  for(var i=0;i<cards.length;i++){
    var s=cards[i].getAttribute('data-search')||'';
    var vis=s.indexOf(v)!==-1;
    cards[i].style.display=vis?'':'none';
    if(vis){
      visCount++;
      var cb=cards[i].querySelector('.cred-badge.yes');
      if(cb)credCount++;
      var tags=cards[i].querySelectorAll('.app-tag');
      for(var j=0;j<tags.length;j++)appSet[tags[j].textContent]=1;
      var dc=parseInt(cards[i].getAttribute('data-dns'))||0;
      dnsTotal+=dc;
    }
  }
  document.getElementById('statDevices').textContent=visCount;
  document.getElementById('statCreds').textContent=credCount;
  document.getElementById('statApps').textContent=Object.keys(appSet).length;
  document.getElementById('statDns').textContent=dnsTotal;
}
</script>
</body>
</html>
"""

print(html)
