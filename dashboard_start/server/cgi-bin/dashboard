ip_block = """
          <!-- IP Block -->
          <tr class="ip-row">
            <td>
              <a href="details?ip=<IP_ADDRESS>" class="ip-link" target="_blank">
                <IP_ADDRESS>
              </a>
              <div class="ip-meta"><PCAPFILE></div>
            </td>
            <td>
              <span class="status online"><DATE></span>
            </td>
          </tr>
"""

stat = """
                <div class="stat-card">
                  <div class="stat-label"><APP></div>
                  <div class="stat-value"><APPNAME></div>
                </div>
"""

stat_grid_start = """
          <tr class="stats-row">
            <td colspan="2">
              <div class="stats-grid">
"""

stat_grid_end = """
              </div>
            </td>
          </tr>
"""

footer = """
        </tbody>
      </table>
    </div>
  </div>
  <script>
    function filterIPs() {
      const input = document.getElementById('searchInput');
      const filter = input.value.toLowerCase();
      const tbody = document.querySelector('tbody');
      const rows = tbody.querySelectorAll('tr');

      for (let i = 0; i < rows.length; i += 2) {
        const ipRow = rows[i];
        const statsRow = rows[i + 1];

        const ipText = ipRow.innerText.toLowerCase();
        const statsText = statsRow.innerText.toLowerCase();
        const combinedText = ipText + ' ' + statsText;

        if (combinedText.includes(filter)) {
          ipRow.style.display = '';
          statsRow.style.display = '';
        } else {
          ipRow.style.display = 'none';
          statsRow.style.display = 'none';
        }
      }
    }
  </script>
</body>
</html>
"""
# Connect to the SQLite database
conn = sqlite3.connect('../data.db')

# Create a cursor object
c = conn.cursor()

# Perform a SELECT statement on the 'targets' table, storing the IP and MAC combination in variables
c.execute("SELECT id, ip, mac, pcap, date FROM targets")
rows = c.fetchall()
ip_mac_combinations = [(row[0], row[1], row[2], row[3], row[4]) for row in rows]

entries = ""
number_of_credentials = 0
number_of_entries = 0
for id, ip, mac, pcap, date in ip_mac_combinations:
  # print IP block
  tmp = ip_block.replace("<IP_ADDRESS>", ip)

  if pcap != "n/a":
    tmp = tmp.replace("<PCAPFILE>", pcap.split("/")[len(pcap.split("/"))-1])
  else:
    tmp = tmp.replace("<PCAPFILE>", pcap)
  
  # adding date...
  readable_date = datetime.fromtimestamp(int(float(date))).strftime('%Y-%m-%d %H:%M:%S')
  ip_output = tmp.replace("<DATE>", readable_date.split(" ")[0])
  entries += ip_output
  entries += stat_grid_start
  
  # credentials
  tmp = stat.replace("<APP>", "Credentials")
  c.execute("SELECT count(id) FROM credentials WHERE target=" + str(id))
  row = c.fetchone()
  hostname = "n/a"
  if (int(row[0]) > 0):
    c.execute("SELECT username, password, hostname FROM credentials WHERE target=" + str(id))
    pwRow = c.fetchone()
    hostname = pwRow[2]
    credentials_output = tmp.replace("<APPNAME>", "<span class=\"status online\">user: " + pwRow[0] + "<br />password: " + pwRow[1] + "</span>")
    number_of_credentials += 1
  else:
    credentials_output = tmp.replace("<APPNAME>", "<span class=\"status offline\">n/a</span>")
  entries += credentials_output
  
  # mac
  tmp = stat.replace("<APP>", "MAC")
  mac_output = tmp.replace("<APPNAME>", mac)
  entries += mac_output
  
  # hostname
  tmp = stat.replace("<APP>", "HOSTNAME")
  hostname_output = tmp.replace("<APPNAME>", hostname)
  entries += hostname_output
  
  # print apps
  c.execute("SELECT appname from targetapps WHERE target=" + str(id))
  rows = c.fetchall()
  app_combination = [(row[0]) for row in rows]
  
  different_apps = set()
  apps_output = ""
  for appname in app_combination:
    c.execute("SELECT app from apps WHERE id=" + str(appname))
    rows = c.fetchall()
    app_names = [(row[0]) for row in rows]
    for app in app_names:
      if app not in different_apps:
        tmp = stat.replace("<APP>", "Device/App")
        tmp = tmp.replace("<APPNAME>", app)
        different_apps.add(app)
        apps_output += tmp
  entries += apps_output
  entries += stat_grid_end
  number_of_entries += 1

head = head.replace("<NUMBEROFIPS>", str(number_of_entries))
head = head.replace("<NUMBEROFCREDS>", str(number_of_credentials))
print(head)
print(entries)
print(footer)
