#!/usr/bin/env python3
import sqlite3
from datetime import datetime

print("Content-Type: text/html")
print()

conn = sqlite3.connect("../data.db")
c = conn.cursor()

# Query 1: All targets
c.execute("SELECT id, ip, mac, pcap, date FROM targets")
targets = c.fetchall()

# Query 2: All app name mappings
c.execute("SELECT id, app FROM apps")
app_name_map = {row[0]: row[1] for row in c.fetchall()}

# Query 3: All targetapps joined with app names
c.execute("""
    SELECT targetapps.target, apps.app
    FROM targetapps
    JOIN apps ON targetapps.appname = apps.id
""")
target_apps = {}
target_app_counts = {}
for target_id, app_name in c.fetchall():
    if target_id not in target_apps:
        target_apps[target_id] = []
        target_app_counts[target_id] = {}
    if app_name not in target_apps[target_id]:
        target_apps[target_id].append(app_name)
    target_app_counts[target_id][app_name] = target_app_counts[target_id].get(app_name, 0) + 1

# Query 4: All credentials
c.execute("SELECT target, username, password, hostname FROM credentials")
creds = {}
for target_id, username, password, hostname in c.fetchall():
    creds[target_id] = (username, password, hostname)

# Query 5: All DNS counts
c.execute("SELECT ip, COUNT(*) FROM dns_queries GROUP BY ip")
dns_counts = dict(c.fetchall())

c.execute("SELECT COUNT(*) FROM dns_queries")
total_dns = c.fetchone()[0]

conn.close()

total_creds = 0
total_apps = 0
target_data = []

for tid, ip, mac, pcap, date in targets:
    cred = creds.get(tid)
    if cred:
        username, _password, hostname = cred
        has_creds = True
    else:
        username = None
        hostname = "n/a"
        has_creds = False

    if has_creds and username and username != "NONE":
        total_creds += 1

    apps = target_apps.get(tid, [])
    total_apps += len(apps)

    app_counts = target_app_counts.get(tid, {})
    ios_score = app_counts.get("iOS", 0)
    android_score = app_counts.get("Android", 0)
    if ios_score > android_score:
        os_type = "iOS"
    elif android_score > ios_score:
        os_type = "Android"
    elif ios_score > 0 and android_score > 0:
        os_type = "Mixed"
    else:
        os_type = None

    dns_count = dns_counts.get(tid, 0)

    pcap_name = pcap.split("/")[-1] if pcap != "n/a" else "n/a"
    readable_date = datetime.fromtimestamp(int(float(date))).strftime("%Y-%m-%d")
    target_data.append({
        "ip": ip, "mac": mac, "hostname": hostname, "date": readable_date,
        "pcap": pcap_name, "has_creds": has_creds, "username": username,
        "apps": apps, "os": os_type, "dns_count": dns_count,
    })

app_colors = {
    "Instagram": "#E1306C", "Facebook": "#1877F2", "WhatsApp": "#25D366",
    "TikTok": "#000000", "WeChat": "#07C160", "Twitter": "#1DA1F2",
    "Telegram": "#26A5E4", "Spotify": "#1DB954",
    "Huawei": "#CF0A2C", "Tencent": "#25D366", "Samsung": "#1428A0",
    "Android": "#3DDC84", "iOS": "#007AFF", "Amazon": "#FF9900", "Google": "#4285F4",
    "YouTube": "#FF0000", "Xiaomi": "#FF6700", "Baidu": "#2932E1",
    "Snapchat": "#FFFC00", "Soundcloud": "#FF5500",
    "Duolingo": "#58CC02", "Firefox": "#FF7139", "Signal": "#3A76F0",
    "ChatGPT": "#10A37F", "Claude": "#D97757", "Rewe": "#E2001A",
}

n = len(target_data)

html = f"""<!DOCTYPE html>
